      <column caption='Límite superior del coeficiente' datatype='real' name='[Límite inferior del coeficiente (copia)_1195755235512351]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [tipo] = &quot;logistico&quot; THEN [or_ic_sup] ELSE [coef_ic_sup] END' />
