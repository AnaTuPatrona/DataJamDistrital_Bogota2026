      <aliases enabled='yes' />
      <column caption='Brecha de ranking' datatype='string' name='[Calculation_1195755211173893]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([en_encuesta (fact_indicadores_localidad.csv)]) = 0 THEN &quot;Sin comparación posible&quot;&#13;&#10;ELSEIF AVG([delta_rank]) &gt;= 4 THEN &quot;Se ve mejor de lo que está&quot;&#13;&#10;ELSEIF AVG([delta_rank]) &lt;= -4 THEN &quot;Se ve peor de lo que está&quot;&#13;&#10;ELSE &quot;Sin cambio relevante&quot;&#13;&#10;END' />
      </column>
      <column caption='Indicador del mapa' datatype='real' name='[Calculation_1195755215687695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1195755213893639]&#13;&#10;  WHEN &quot;Necesidad No Atendida&quot;         THEN [INA]&#13;&#10;  WHEN &quot;Violencia visible y afrontada&quot; THEN [TAC_M] * 100&#13;&#10;  WHEN &quot;Barrera para denunciar&quot;        THEN [IBA]&#13;&#10;  WHEN &quot;Cobertura real&quot;                THEN [RC_real]&#13;&#10;  WHEN &quot;Cobertura administrativa&quot;      THEN [RC_admin]&#13;&#10;  WHEN &quot;Carga de cuidado en mujeres&quot;   THEN [pct_carga_mujer] * 100&#13;&#10;END' />
      </column>
      <column caption='Sufijo de unidad' datatype='string' name='[Calculation_1195755215867920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1195755213893639]&#13;&#10;  WHEN &quot;Violencia visible y afrontada&quot; THEN &quot;%&quot;&#13;&#10;  WHEN &quot;Carga de cuidado en mujeres&quot;   THEN &quot;%&quot;&#13;&#10;  WHEN &quot;Cobertura real&quot;                THEN &quot; atenciones/1.000&quot;&#13;&#10;  WHEN &quot;Cobertura administrativa&quot;      THEN &quot; atenciones/caso&quot;&#13;&#10;  ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Estado de la localidad' datatype='string' name='[Calculation_1195755216875540]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([en_encuesta (fact_indicadores_localidad.csv)]) = 0 THEN &quot;Sin datos de encuesta&quot;&#13;&#10;ELSEIF MIN([publicable]) = 0 THEN &quot;Estimación no publicable&quot;&#13;&#10;ELSE &quot;Estimación válida&quot;&#13;&#10;END' />
      </column>
      <column caption='Valor enmascarado' datatype='real' name='[Calculation_1195755229880341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MIN([publicable]) = 1 AND MIN([en_encuesta (fact_indicadores_localidad.csv)]) = 1&#13;&#10;THEN AVG([Calculation_1195755215687695])&#13;&#10;END' />
      </column>
      <column caption='Semáforo de necesidad' datatype='string' name='[Calculation_1195755230334998]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([en_encuesta (fact_indicadores_localidad.csv)]) = 0 THEN &quot;Sin dato&quot;&#13;&#10;ELSEIF AVG([INA]) &gt;= 75 THEN &quot;Crítico&quot;&#13;&#10;ELSEIF AVG([INA]) &gt;= 50 THEN &quot;Alto&quot;&#13;&#10;ELSEIF AVG([INA]) &gt;= 25 THEN &quot;Medio&quot;&#13;&#10;ELSE &quot;Bajo&quot;&#13;&#10;END' />
      </column>
      <column caption='Etiqueta de intervalo' datatype='string' name='[Calculation_1195755233124376]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND(AVG([TAC_M])*100, 1)) + &quot;% (IC 95%: &quot;&#13;&#10;+ STR(ROUND(AVG([TAC_M_ic_inf])*100, 1)) + &quot;% – &quot;&#13;&#10;+ STR(ROUND(AVG([TAC_M_ic_sup])*100, 1)) + &quot;%)&quot;' />
      </column>
      <column caption='INA del escenario' datatype='real' name='[Calculation_1195755233497113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(IF [escenario] = [Parameters].[p_Indicador_Mapa (copia)_1195755214934025] THEN [INA_escenario] END)' />
      </column>
      <column caption='Ranking del escenario' datatype='integer' name='[Calculation_1195755233665050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(IF [escenario] = [Parameters].[p_Indicador_Mapa (copia)_1195755214934025] THEN [rank_escenario] END)' />
      </column>
      <column caption='Filtro Top N' datatype='boolean' name='[Calculation_1195755234041883]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1195755233665050] &lt;= [Parameters].[Parámetro 1195755215314956]' />
      </column>
      <column caption='Coeficiente a graficar' datatype='real' name='[Calculation_1195755234168860]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [tipo] = &quot;logistico&quot; THEN [odds_ratio] ELSE [coeficiente] END' />
      </column>
      <column caption='Límite inferior del coeficiente' datatype='real' name='[Calculation_1195755235209245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [tipo] = &quot;logistico&quot; THEN [or_ic_inf] ELSE [coef_ic_inf] END' />
      </column>
      <column caption='Ancho IC del coeficiente' datatype='real' name='[Calculation_1195755235741728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Límite inferior del coeficiente (copia)_1195755235512351]-[Calculation_1195755235209245]' />
      </column>
      <column caption='Línea nula' datatype='integer' name='[Calculation_1195755236085793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [tipo] = &quot;logistico&quot; THEN 1 ELSE 0 END' />
      </column>
